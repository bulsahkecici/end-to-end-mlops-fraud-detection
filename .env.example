# Copy to .env and fill in real values before using the `production-like`
# docker-compose profile. Never commit the real .env file.

# --- MLflow -----------------------------------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=ieee-cis-fraud
MODEL_NAME=ieee_fraud_lgbm
CHAMPION_ALIAS=champion
CANDIDATE_ALIAS=candidate
DEPLOYMENT_STATE_PATH=artifacts/deployment/current.json

# --- production-like profile only: Postgres backend store -------------------
POSTGRES_DB=mlflow
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=change-me

# --- production-like profile only: MinIO (S3-compatible) artifact store -----
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me-too
MLFLOW_ARTIFACT_BUCKET=mlflow-artifacts

# --- optional host port/state overrides --------------------------------------
# API_HOST_PORT and MLFLOW_HOST_PORT apply only to local-lite. In
# production-like, only NGINX_HOST_PORT is published; API, MLflow, and MinIO
# remain reachable only on the internal Docker network.
API_HOST_PORT=8000
MLFLOW_HOST_PORT=5000
NGINX_HOST_PORT=8080
DEPLOYMENT_STATE_DIR=./artifacts/deployment

# --- Sampling / split / training ---------------------------------------------
SAMPLE_ROWS=300000
SAMPLING_STRATEGY=time_ordered
SPLIT_STRATEGY=temporal
RANDOM_SEED=42

# --- Threshold / cost ---------------------------------------------------------
THRESHOLD_STRATEGY=best_f1
FIXED_THRESHOLD=0.5
TARGET_RECALL=0.80
FALSE_NEGATIVE_COST=25.0
FALSE_POSITIVE_COST=1.0

# --- Promotion gates ------------------------------------------------------------
MIN_PR_AUC=0.10
MIN_RECALL=0.10
MAX_CHAMPION_REGRESSION=0.02

# --- API ------------------------------------------------------------------------
API_MAX_BATCH_SIZE=500
API_MAX_REQUEST_BYTES=2000000
API_KEY_ENABLED=false
API_KEY=
CORS_ALLOW_ORIGINS=*

# --- nginx rate limiting (docker compose `nginx`/`nginx-prod` service, port 8080) --
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20
