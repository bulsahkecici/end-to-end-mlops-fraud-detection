FROM python:3.11.17-slim-trixie@sha256:45037981b62b34b44602584fccbc4d884d5f7dc92c7ee86bb38a698a79fe1e51

RUN DEBIAN_FRONTEND=noninteractive apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y \
    && rm -rf /var/lib/apt/lists/*

# MLflow does not publish a ghcr.io/mlflow/mlflow:v2.22.5 image. Build the
# server from the same pinned Python base and package versions as the runtime,
# including the Postgres/S3 drivers required by the production-like profile.
RUN pip install --no-cache-dir \
    mlflow==2.22.5 \
    sqlalchemy==2.0.51 \
    psycopg2-binary==2.9.10 \
    boto3==1.35.90

# Build tooling is unnecessary for the tracking server after installation.
RUN python -m pip uninstall -y setuptools wheel && python -m pip check
