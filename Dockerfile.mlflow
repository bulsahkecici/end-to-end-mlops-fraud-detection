FROM cgr.dev/chainguard/wolfi-base:latest@sha256:824f77df45397eb954dfb963db255907ee8842e3446353ce93d688e5e862f51d AS builder
RUN apk add --no-cache python-3.11=3.11.17-r0 libgomp=16.2.0-r1 libstdc++=16.2.0-r1 ca-certificates-bundle=20260909-r2 tzdata=2026e-r0
RUN python3.11 -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH
COPY docker/mlflow.constraints /constraints.txt
RUN pip install --no-cache-dir --only-binary=:all: -c /constraints.txt \
    mlflow==2.22.5 sqlalchemy==2.0.51 psycopg2-binary==2.9.10 boto3==1.35.90 \
    lightgbm==4.6.0 numpy==2.0.2 pandas==2.2.3 scikit-learn==1.5.2 joblib==1.4.2
RUN python -m pip uninstall -y setuptools wheel && python -m pip check

FROM cgr.dev/chainguard/wolfi-base:latest@sha256:824f77df45397eb954dfb963db255907ee8842e3446353ce93d688e5e862f51d AS runtime
RUN apk add --no-cache python-3.11=3.11.17-r0 libgomp=16.2.0-r1 libstdc++=16.2.0-r1 ca-certificates-bundle=20260909-r2 tzdata=2026e-r0
COPY --from=builder /opt/venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH LANG=C.UTF-8 PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
RUN python -m pip check
CMD ["python"]
